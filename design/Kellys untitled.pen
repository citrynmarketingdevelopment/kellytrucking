            {
              "type": "text",
              "id": "h19DB",
              "name": "Where do you work? — editable Tomorrow Bold",
              "fill": "$kelly-road-ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "WHERE DO YOU WORK?",
              "lineHeight": 1.2,
              "fontFamily": "$kelly-font-subheading",
              "fontSize": 22,
              "fontWeight": "700"
            },
            {
              "type": "text",
              "id": "Qpbc8",
              "name": "Where do you work? answer",
              "fill": "$kelly-road-ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Based in Bakersfield, Kelly Trucking serves Kern County and California projects. We supply and haul dirt, clean fill, rock, base rock, gravel, sand, and asphalt, and coordinate export hauling for excess dirt and debris.",
              "lineHeight": 1.5556,
              "fontFamily": "$kelly-font-body",
              "fontSize": 18,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "G0e1k",
              "name": "How do I get pricing? — editable Tomorrow Bold",
              "fill": "$kelly-road-ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "HOW DO I GET PRICING?",
              "lineHeight": 1.2,
              "fontFamily": "$kelly-font-subheading",
              "fontSize": 22,
              "fontWeight": "700"
            },
            {
              "type": "text",
              "id": "LKIV7",
              "name": "How do I get pricing? answer",
              "fill": "$kelly-road-ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Call (661) 361-7640 or send the material type, quantity, locations, and preferred date. Kelly dispatch can confirm material pricing, trucking availability, and project details.",
              "lineHeight": 1.5556,
              "fontFamily": "$kelly-font-body",
              "fontSize": 18,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "UN0b3",
              "name": "What should I tell you about access? — editable Tomorrow Bold",
              "fill": "$kelly-road-ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "WHAT SHOULD I TELL YOU ABOUT ACCESS?",
              "lineHeight": 1.2,
              "fontFamily": "$kelly-font-subheading",
              "fontSize": 22,
              "fontWeight": "700"
            },
            {
              "type": "text",
              "id": "OqDxz",
              "name": "What should I tell you about access? answer",
              "fill": "$kelly-road-ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Include entry instructions, the available unloading space, any restricted delivery hours, and the person who will receive the truck. Mention tight approaches or other site constraints when you first contact dispatch.",
              "lineHeight": 1.5556,
              "fontFamily": "$kelly-font-body",
              "fontSize": 18,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "zjnPc",
              "name": "What happens after I send a request? — editable Tomorrow Bold",
              "fill": "$kelly-road-ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "WHAT HAPPENS AFTER I SEND A REQUEST?",
              "lineHeight": 1.2,
              "fontFamily": "$kelly-font-subheading",
              "fontSize": 22,
              "fontWeight": "700"
            },
            {
              "type": "text",
              "id": "BgQnV",
              "name": "What happens after I send a request? answer",
              "fill": "$kelly-road-ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Dispatch can review the load, route, timing, and site details with you. A requested date is a starting point for that conversation; availability and pricing need to be confirmed before scheduling.",
              "lineHeight": 1.5556,
              "fontFamily": "$kelly-font-body",
              "fontSize": 18,
              "fontWeight": "normal"
            }
          ]
